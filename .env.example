# Copy to .env and fill in. Never commit the .env file itself.
#
#   cp .env.example .env
#
# Generate a strong JWT secret with:
#   openssl rand -base64 48

# --- Database ---
DB_NAME=minibank
DB_USERNAME=minibank
# Any non-empty value works locally; use a real secret anywhere else.
DB_PASSWORD=change-me-local-only
DB_PORT=5432

# --- API ---
API_PORT=8080
# At least 32 characters. The application refuses to start under the prod
# profile if this is left as one of the values published in this repository.
JWT_SECRET=replace-with-openssl-rand-base64-48-output-at-least-32-chars
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Creates the demo users described in the README. Never enable in production.
SEED_DEMO_DATA=true

# --- Cards ---
# Base64 of 32+ random bytes, protecting stored card numbers. Left empty the keys
# are derived from JWT_SECRET, which is already required; set this in a real
# deployment so card data and sessions can be rotated independently.
#   openssl rand -base64 32
CARD_ENCRYPTION_KEY=

# --- Verification and messaging ---
# Where a verification link should point: the web client's origin.
APP_BASE_URL=http://localhost:3000
# 'dev' writes the message to the log instead of sending it. Switch to 'twilio'
# or 'smtp' with the credentials below to deliver for real. A prod deployment
# refuses to start while either is still 'dev'.
SMS_PROVIDER=dev
EMAIL_PROVIDER=dev
SMS_SENDER=MBank
EMAIL_SENDER=MBank <no-reply@mbank.local>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# DEVELOPMENT ONLY. Returns the one-time code in the API response so a local
# sign-in needs no handset. The prod profile refuses to start with this on.
EXPOSE_VERIFICATION_CODES=true

# --- Frontend ---
WEB_PORT=3000
VITE_API_BASE_URL=http://localhost:8080
